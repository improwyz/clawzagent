# ClawZ local / Docker Compose environment
# Copy to .env and adjust before production use: cp .env.example .env

# Deployment mode: standalone | micro | elastic (compose defaults to micro)
CLAWZ_MODE=micro

# Prebuilt platform images — GHCR primary, Docker Hub optional fallback
# export GITHUB_TOKEN=ghp_xxx          # read:packages (primary)
# export GITHUB_USER=your_github_username
# export DOCKERHUB_USERNAME=your_namespace
# export DOCKERHUB_TOKEN=dckr_pat_xxx  # fallback when GHCR unavailable
# export CLAWZ_HUB_MONOREPO=clawz       # single private Hub repo: clawz:gateway-latest, etc.
CLAWZ_REGISTRY=ghcr.io/improwyz
# CLAWZ_REGISTRY_FALLBACK=docker.io/your_namespace
# CLAWZ_REGISTRY_FALLBACK=docker.io/your_namespace/clawz  # same as CLAWZ_HUB_MONOREPO=clawz
CLAWZ_IMAGE_TAG=latest
# CLAWZ_AGENT_IMAGE set automatically by install; override if needed

# Fleet orchestration (worker spawns agent/tool containers via host Docker)
CLAWZ_DOCKER_NETWORK=clawz-net
CLAWZ_MAX_AGENTS=50

# Development only — set CLAWZ_DISABLE_AUTH=1 for local dev (debug builds only)
CLAWZ_DISABLE_AUTH=0
CLAWZ_STUB_PROVIDER=1

# API keys: hash:user_id:role:tenant_id (see auth/api_key.rs) or plain dev keys when auth disabled
# With CLAWZ_DISABLE_AUTH=0: plain key "dev-key" works, or use hash:user:role:tenant
VALID_API_KEYS=dev-key

# Auth & multi-tenant
CLAWZ_JWT_SECRET=change-me-in-production
CLAWZ_TENANT_ID=default

# Gateway ↔ worker internal auth
CLAWZ_WORKER_TOKEN=change-me-worker-token

# Encryption key for secrets at rest (required in release builds)
CLAWZ_SECRETS_KEY=change-me-secrets-key
WORKER_URL=http://worker:50051
CLAWZ_WORKER_FLEET_URL=http://worker:50051

# Database (Docker Compose service `db`)
POSTGRES_PASSWORD=password
DATABASE_URL=postgresql://postgres:password@db:5432/clawz

# Domain for HTTPS (Caddy auto-TLS). Use hostname, IP, or domain.
CLAWZ_DOMAIN=localhost
# Public URL for webhooks (telephony, channels) and agent containers
CLAWZ_PUBLIC_URL=https://${CLAWZ_DOMAIN:-localhost}

# Optional LLM provider keys (worker)
# OPENAI_API_KEY=
# OPENAI_API_BASE=https://api.openai.com/v1
# ANTHROPIC_API_KEY=
# OPENROUTER_API_KEY=
# GROQ_API_KEY=
# XAI_API_KEY=
# DEEPSEEK_API_KEY=
# TOGETHER_API_KEY=
# FIREWORKS_API_KEY=
# CLAWZ_CUSTOM_LLM_KEY=
# CLAWZ_CUSTOM_LLM_BASE=

# Optional voice WebSocket
# CLAWZ_VOICE_PROVIDER=openai

RUST_LOG=info
