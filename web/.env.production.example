# Build the dashboard to talk directly to the gateway (no Vite proxy).
# Use when serving web/dist via nginx/caddy while gateway runs on :3000.
#
#   cd web
#   cp .env.production.example .env.production
#   npm run build
#   npx serve -s dist -l 4173
#
VITE_API_BASE=http://127.0.0.1:3000/api/v1
VITE_GATEWAY_ORIGIN=http://127.0.0.1:3000
